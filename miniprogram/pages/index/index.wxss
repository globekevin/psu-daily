/* ── PSU Daily News 首页样式 ── */

.page {
  background: #F0F2F5;
  min-height: 100vh;
}

/* ═══ 顶部 Hero ═══ */
.hero {
  background: linear-gradient(135deg, #1E3A5F 0%, #2C5282 100%);
  padding: 60rpx 40rpx 40rpx;
  color: #fff;
  text-align: center;
}
.hero-title {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
}
.hero-sub {
  display: block;
  font-size: 40rpx;
  font-weight: 400;
  margin-top: 8rpx;
  letter-spacing: 4rpx;
  opacity: 0.9;
}
.hero-meta {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 24rpx;
  gap: 24rpx;
}
.hero-date {
  font-size: 26rpx;
  opacity: 0.8;
}
.hero-edition {
  font-size: 24rpx;
  background: rgba(255,255,255,0.2);
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
}

/* ═══ 加载 ═══ */
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  color: #999;
  font-size: 28rpx;
}
.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #E0E0E0;
  border-top-color: #1E3A5F;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 24rpx;
}
@keyframes spin {
  to { transform: rotate(360deg); }
}

/* ═══ 卡片列表 ═══ */
.card-list {
  padding: 24rpx 24rpx 48rpx;
}

/* ═══ 新闻卡片 ═══ */
.news-card {
  background: #fff;
  border-radius: 20rpx;
  margin-bottom: 28rpx;
  padding: 32rpx;
  position: relative;
  box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.06);
  transition: transform 0.15s;
}
.news-card:active {
  transform: scale(0.98);
}

/* ── 分类标签 ── */
.card-tag {
  display: inline-block;
  font-size: 20rpx;
  font-weight: 600;
  padding: 6rpx 18rpx;
  border-radius: 8rpx;
  margin-bottom: 20rpx;
}
.tag-comm     { background: #E6F0FF; color: #1E6FE0; }
.tag-up       { background: #FFEDF5; color: #D43F7A; }
.tag-alumni   { background: #F0F5FF; color: #5538EE; }
.tag-sports   { background: #FFF3E6; color: #E07B1E; }
.tag-admin    { background: #F0F0F0; color: #555; }
.tag-research { background: #E6FFF0; color: #1E9E5A; }

/* ── 标题 ── */
.card-body {
  margin-bottom: 20rpx;
}
.card-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #1A1A2E;
  line-height: 1.5;
}
.card-title-en {
  display: block;
  font-size: 24rpx;
  color: #888;
  margin-top: 6rpx;
  line-height: 1.4;
}

/* ── 配图 ── */
.card-image {
  width: 100%;
  height: 360rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  background: #F5F5F5;
}

/* ── 摘要 ── */
.card-summary {
  font-size: 26rpx;
  color: #555;
  line-height: 1.7;
  margin-bottom: 24rpx;
  padding: 20rpx 24rpx;
  background: #FAFBFC;
  border-radius: 12rpx;
  border-left: 6rpx solid #1E3A5F;
}

/* ── 底部 ── */
.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid #F0F0F0;
}
.card-source {
  font-size: 22rpx;
  color: #999;
}
.card-arrow {
  font-size: 24rpx;
  color: #1E3A5F;
  font-weight: 600;
}

/* ═══ 底部 ═══ */
.footer {
  padding: 48rpx 40rpx;
  text-align: center;
}
.footer-text {
  font-size: 22rpx;
  color: #BBB;
  line-height: 1.6;
}
